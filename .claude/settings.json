{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard.ts\"",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",

      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gcloud/**)",

      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Bash(cat *credential*)",
      "Bash(cat *secret*)",
      "Bash(type *.env)",
      "Bash(type *.env.*)",
      "Bash(Get-Content *.env)",
      "Bash(Get-Content *.env.*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * *.env*)",
      "Bash(rg * *.env*)",
      "Bash(source *.env*)",
      "Bash(cp *.env* *)",
      "Bash(mv *.env* *)",
      "Bash(rm *.env*)",
      "Bash(printenv*)",
      "Bash(env)",

      "PowerShell(Get-Content *.env)",
      "PowerShell(Get-Content *.env.*)",
      "PowerShell(Get-Content *credential*)",
      "PowerShell(Get-Content *secret*)",
      "PowerShell(type *.env)",
      "PowerShell(type *.env.*)",
      "PowerShell(cat *.env)",
      "PowerShell(cat *.env.*)",
      "PowerShell(Select-String * *.env*)",
      "PowerShell(Copy-Item *.env* *)",
      "PowerShell(Move-Item *.env* *)",
      "PowerShell(Remove-Item *.env*)"
    ]
  }
}
